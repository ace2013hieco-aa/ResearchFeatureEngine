<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <RootNamespace>ResearchFeatureEngine</RootNamespace>
    <AssemblyName>ResearchFeatureEngine</AssemblyName>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <GenerateAssemblyInformationalVersionAttribute>true</GenerateAssemblyInformationalVersionAttribute>

    <!-- NuGet package metadata (v0.1.0) -->
    <IsPackable>true</IsPackable>
    <PackageId>ResearchFeatureEngine</PackageId>
    <Version>0.1.0</Version>
    <Authors>Osat Zoghi</Authors>
    <Description>Platform-independent quantitative research pipeline (Reference → Distance → Scale → Normalize → Statistics). The same .NET 6 core drives cTrader, Python, and MT5 surfaces; correctness verified by 491 portable golden tests.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/ace2013hieco-aa/ResearchFeatureEngine</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>quantitative-finance;algorithmic-trading;backtesting;ctrader;csharp;indicator;research;platform-independent;net6</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
  </PropertyGroup>

  <!-- F1 (M10.3): the core engine assembly is platform-independent —
       no cTrader API dependency. The cAlgo.API reference moved to the
       adapter assembly (Adapters/ResearchFeatureEngine.CTrader.csproj),
       which references this project. Adapter sources are compiled into
       that assembly, not this one. -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>ResearchFeatureEngine.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Adapters\**" />
    <EmbeddedResource Remove="Adapters\**" />
    <None Remove="Adapters\**" />
    <Compile Remove="Tests\**" />
    <EmbeddedResource Remove="Tests\**" />
    <None Remove="Tests\**" />
    <Compile Remove="ATRsmooth2\**" />
    <EmbeddedResource Remove="ATRsmooth2\**" />
    <None Remove="ATRsmooth2\**" />
    <Compile Remove="Indicators\**" />
    <EmbeddedResource Remove="Indicators\**" />
    <None Remove="Indicators\**" />
    <Compile Remove="tools\**" />
    <EmbeddedResource Remove="tools\**" />
    <None Remove="tools\**" />
    <Compile Remove="bin\**" />
    <EmbeddedResource Remove="bin\**" />
    <None Remove="bin\**" />
  </ItemGroup>

</Project>
