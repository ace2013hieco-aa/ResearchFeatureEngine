<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net6.0</TargetFramework>
    <RootNamespace>ResearchFeatureEngine.BulkExport</RootNamespace>
    <AssemblyName>BulkExport</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <!-- Engine identity baked into the build (M10.0 §7). The M10.1
       certification build sets EngineCommit explicitly on the
       command line; CI/local defaults mark themselves 'unresolved'
       so an unpinned manifest is visible, never silent. -->
  <PropertyGroup>
    <EngineCommit Condition="'$(EngineCommit)' == ''">unresolved</EngineCommit>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>EngineCommit</_Parameter1>
      <_Parameter2>$(EngineCommit)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\ResearchFeatureEngine.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>ResearchFeatureEngine.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <None Include="registry.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
