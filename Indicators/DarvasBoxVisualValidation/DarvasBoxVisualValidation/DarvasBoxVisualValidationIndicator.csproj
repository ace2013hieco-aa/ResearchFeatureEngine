<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <RootNamespace>ResearchFeatureEngine.Indicators</RootNamespace>
    <AssemblyName>DarvasBoxVisualValidationIndicator</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="cTrader.Automate" Version="1.*" />
  </ItemGroup>

  <!-- F1 (M10.3): CTraderMarketData/CTraderPriceSeries live in the
       adapter assembly (Applications → Adapters → Core). -->
  <ItemGroup>
    <ProjectReference Include="..\..\..\Adapters\ResearchFeatureEngine.CTrader.csproj" />
    <ProjectReference Include="..\..\..\ResearchFeatureEngine.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="**\*.Tests.cs" />
  </ItemGroup>

</Project>
